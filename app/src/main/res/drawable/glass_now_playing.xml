<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BASE GLASS -->
    <item>
        <shape>
            <gradient
                android:startColor="#EF000000"
                android:endColor="#CC000000"
                android:angle="270"/>

            <corners android:radius="24dp"/>
        </shape>
    </item>

    <!-- LIGHT TOP HIGHLIGHT -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp">
        <shape>
            <gradient
                android:startColor="#40A09595"
                android:endColor="#00FFFFFF"
                android:angle="270"/>

            <corners android:radius="23dp"/>
        </shape>
    </item>

    <!-- SOFT GLASS BORDER -->
    <item>
        <shape>
            <stroke
                android:width="1dp"
                android:color="#5D493838"/>

            <corners android:radius="24dp"/>
        </shape>
    </item>

</layer-list>
