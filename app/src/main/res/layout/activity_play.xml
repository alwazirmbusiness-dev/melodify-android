<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#121212">

    <!-- Top Bar -->
    <ImageButton
        android:id="@+id/backbutton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="30dp"
        android:background="@android:color/transparent"
        android:src="@drawable/left_arrow"
        app:tint="@android:color/white"
        android:contentDescription="Back_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageButton
        android:id="@+id/img_fav_1"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="30dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Now Playing Text -->
    <TextView
        android:id="@+id/tv_now_playing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Now playing"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/backbutton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- App Name -->

    <!-- Album Artwork -->

    <!-- Song Titles -->


    <!-- SeekBar -->

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/artist_pic"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        android:scaleType="centerCrop"
        android:src="@drawable/iconic"
        app:layout_constraintTop_toBottomOf="@id/tv_now_playing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/second"
        app:layout_constraintDimensionRatio="1:1" />

    <TextView
        android:id="@+id/second"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/alexandria_font"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/artist_pic" />

    <androidx.appcompat.widget.AppCompatSeekBar
        android:id="@+id/seek_song_progressbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/second"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Time Labels -->
    <TextView
        android:id="@+id/tv_song_current_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/total_duration"
        android:fontFamily="@font/alexandria_font"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/seek_song_progressbar"
        app:layout_constraintStart_toStartOf="@id/seek_song_progressbar"/>

    <TextView
        android:id="@+id/total_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/alexandria_font"
        android:text="@string/total_duration"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/seek_song_progressbar"
        app:layout_constraintEnd_toEndOf="@id/seek_song_progressbar"/>

    <!-- Playback Controls (Horizontal Chain) -->
    <ImageButton
        android:id="@+id/btn_prev"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@drawable/buttonstyle"
        android:onClick="controlClick"
        app:srcCompat="@drawable/ic_skip_previous"
        app:tint="#FFFFFF"
        tools:ignore="SpeakableTextPresentCheck"
        app:layout_constraintTop_toBottomOf="@id/tv_song_current_duration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_play_wrapper"
        app:layout_constraintHorizontal_chainStyle="packed"/>

    <!-- Play FAB with large icon -->
    <FrameLayout
        android:id="@+id/btn_play_wrapper"
        android:layout_width="84dp"
        android:layout_height="84dp"
        app:layout_constraintTop_toTopOf="@id/btn_prev"
        app:layout_constraintBottom_toBottomOf="@id/btn_prev"
        app:layout_constraintStart_toEndOf="@id/btn_prev"
        app:layout_constraintEnd_toStartOf="@id/btn_next">

        <ImageView
            android:id="@+id/btn_play"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:foregroundGravity="center"
            android:src="@drawable/play__1_"
            app:useCompatPadding="false"
            android:clickable="true"
            app:tint="@android:color/white"/>
    </FrameLayout>

    <ImageButton
        android:id="@+id/btn_next"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@drawable/buttonstyle"
        android:onClick="controlClick"
        app:srcCompat="@drawable/ic_skip_next"
        app:tint="#FFFFFF"
        tools:ignore="SpeakableTextPresentCheck"
        app:layout_constraintTop_toTopOf="@id/btn_prev"
        app:layout_constraintStart_toEndOf="@id/btn_play_wrapper"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bottom Controls -->
    <ImageButton
        android:id="@+id/btn_repeat"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:onClick="controlClick"
        android:src="@drawable/ic_repeat"
        app:tint="@color/colorDarkOrange"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="32dp"/>

    <ImageButton
        android:id="@+id/btn_shuffle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        android:onClick="controlClick"
        android:src="@drawable/ic_shuffle"
        app:tint="@color/colorDarkOrange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"/>

    <ImageButton
        android:id="@+id/show_pup"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@android:color/transparent"
        app:srcCompat="@drawable/moreapps"
        android:scaleType="centerInside"
        android:onClick="onShowPop"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="@id/btn_repeat"
        app:layout_constraintStart_toEndOf="@id/btn_repeat"
        app:layout_constraintEnd_toStartOf="@id/btn_timerr"
        app:layout_constraintHorizontal_bias="0.3"/>

    <ImageView
        android:id="@+id/btn_timerr"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_timer"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="@id/btn_repeat"
        app:layout_constraintStart_toEndOf="@id/show_pup"
        app:layout_constraintEnd_toStartOf="@id/btn_shuffle"
        app:layout_constraintHorizontal_bias="0.7"/>

</androidx.constraintlayout.widget.ConstraintLayout>
